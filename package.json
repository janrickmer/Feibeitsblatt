{
  "name": "feibeitsblatt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Feibeitsblatt – Schreibeditor mit Aufgabencodes, KI-Feedback und verschlüsselter Abgabe (Cloudflare Worker + D1)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
